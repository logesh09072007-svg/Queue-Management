# QueueSense AI - Environment Configuration Example
PROJECT_NAME="QueueSense AI"
ENVIRONMENT="development"
DEMO_MODE=true

# Security & Auth
SECRET_KEY="queuesense-super-secret-jwt-key-for-college-canteen-ai"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./canteen.db"

# Default Canteen Settings
DEFAULT_CANTEEN_CAPACITY=120
DEFAULT_ACTIVE_COUNTERS=3
DEFAULT_AVG_SERVICE_TIME_SECONDS=90
